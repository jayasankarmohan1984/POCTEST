resource "azurerm_virtual_machine_extension" "ad_install" {
  count                = var.custom_vm_name != null ? 1 : 0
  name                 = "ext-appvmjtk${var.env_code}-install-adds"
  virtual_machine_id   = azurerm_windows_virtual_machine.vm[0].id
  publisher            = "Microsoft.Compute"
  type                 = "CustomScriptExtension"
  type_handler_version = "1.10"

  settings = jsonencode({
    commandToExecute = "powershell -ExecutionPolicy Bypass -File install-adds.ps1 -DomainName corp.local -SafeModePwd '${var.admin_password}'"
  })
}